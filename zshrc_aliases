# alias cd='zoxide'
alias ls='eza'
alias cat='bat'
alias grep='rg'
alias du='dust'
alias tree='broot'
alias top='htop'


# yazi / file / folder explorer
function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	command yazi "$@" --cwd-file="$tmp"
	IFS= read -r -d '' cwd < "$tmp"
	[ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && builtin cd -- "$cwd"
	rm -f -- "$tmp"
}
