# Zoxide aliases
# z <path>  - Jump to a directory (fuzzy match)
# zi        - Interactive directory selection with fzf
# za <path> - Add a directory to zoxide database
# zq <path> - Query zoxide database
# zr <path> - Remove a directory from zoxide database
alias cd='z'  # Make cd use zoxide for smarter directory jumping

# Modern CLI replacements
alias ls='eza'
alias cat='bat'
alias grep='rg'
alias du='dust'
alias tree='broot'
alias top='htop'


# yazi / file / folder explorer
function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	command yazi "$@" --cwd-file="$tmp"
	IFS= read -r -d '' cwd < "$tmp"
	[ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && builtin cd -- "$cwd"
	rm -f -- "$tmp"
}
